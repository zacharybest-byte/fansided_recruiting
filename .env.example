# Copy to .env (never commit .env). All values below are examples.

# --- Required in production ---
NODE_ENV=production
BASE_URL=https://recruit.example.com
DATA_DIR=/data
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: if it changes, every rep must sign in again before they can send email.
TOKEN_ENCRYPTION_KEY=replace-me
# Upserted as active admins at every start (bootstrap). Comma-separated.
ADMIN_EMAILS=zach@fansided.com

# --- Optional ---
PORT=3000
# Extra gate on top of the users table. Comma-separated.
ALLOWED_EMAIL_DOMAINS=fansided.com,minutemedia.com
MAX_UPLOAD_MB=10
APP_TIMEZONE=America/New_York
# Number of reverse proxies in front of the app (Caddy on the VM = 1). Lets the per-IP
# rate limit read the client address from X-Forwarded-For. 0/unset = socket address.
# On Cloud Run check the X-Forwarded-For you actually receive (Google's front end may add
# its own hop) and set 1 or 2 accordingly.
TRUST_PROXY=1

# Reserved for the future Voltax integration (unused in v1).
VOLTAX_API_URL=
VOLTAX_API_KEY=

# --- Development only (refused when NODE_ENV=production) ---
# DEV_LOGIN=1        sign in as any active user without Google
# EMAIL_MODE=log     record outgoing mail in the dev_mail_log table + stdout instead of calling Gmail
