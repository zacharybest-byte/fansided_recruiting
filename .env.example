# Copy to .env for local runs (never commit .env). These are ALL the settings the app reads
# (plus PORT locally, and the NODE_ENV / VERCEL* variables the platform sets).

# Database. Leave both unset locally to use a SQLite file in ./data.
# On Vercel the Turso integration sets them for you.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Required in production: at least 32 characters, 16+ of them distinct. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# First admin: open /setup?token=<SETUP_TOKEN> once, then remove SETUP_TOKEN.
# SETUP_TOKEN must be at least 32 characters (10+ distinct). Generate with the same command as above.
ADMIN_EMAIL=
SETUP_TOKEN=

# Optional
# BASE_URL=https://recruit.example.com
# NOTIFY_WEBHOOK_URL=https://chat.example.com/incoming-webhook   (https only)
